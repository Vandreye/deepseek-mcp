{
  "name": "deepseek-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets Claude Code hand tasks to DeepSeek as a cheap subagent",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "deepseek-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "claude-commands",
    "scripts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "setup": "node scripts/install.mjs",
    "check:live": "npm run build && node scripts/live-check.mjs",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "engines": {
    "node": ">=20.3"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "diff": "^9.0.0",
    "fast-glob": "^3.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}

# Required. Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-...

# Optional overrides (defaults shown)
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL_FLASH=deepseek-flash
# DEEPSEEK_MODEL_PRO=deepseek-v4-pro
# DEEPSEEK_THINKING=enabled            # enabled | disabled
# DEEPSEEK_REASONING_EFFORT=high       # low | high | max
# DEEPSEEK_MAX_STEPS=25                # tool-loop steps per task (types below have their own)
# DEEPSEEK_MAX_STEPS_REVIEW=80
# DEEPSEEK_MAX_STEPS_RESEARCH=80
# DEEPSEEK_MAX_STEPS_DEBUG=50
# DEEPSEEK_MAX_STEPS_PLAN=40
# DEEPSEEK_MAX_TASK_TOKENS=3000000     # total input tokens per task
# DEEPSEEK_MAX_REPLY_CHARS=3200        # size cap of the report Claude sees (~800 tokens)
# DEEPSEEK_COMMAND_TIMEOUT_SEC=300
# DEEPSEEK_ALLOW_COMMANDS=make test;cargo fmt --check   # extra auto-allowed command prefixes
# DEEPSEEK_ELICITATION=auto            # auto | off  (ask you directly when the client supports it)
# DEEPSEEK_WORKSPACE=                  # default workspace (default: the folder Claude Code runs in)

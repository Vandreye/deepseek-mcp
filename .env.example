# Required. Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-...

# Optional overrides (defaults shown)
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL_FLASH=deepseek-flash
# DEEPSEEK_MODEL_PRO=deepseek-v4-pro
# DEEPSEEK_THINKING=enabled            # enabled | disabled
# DEEPSEEK_REASONING_EFFORT=high       # low | high | max
# DEEPSEEK_MAX_STEPS=25                # tool-loop steps per task (types below have their own)
# DEEPSEEK_MAX_STEPS_REVIEW=80
# DEEPSEEK_MAX_STEPS_RESEARCH=80
# DEEPSEEK_MAX_STEPS_DEBUG=50
# DEEPSEEK_MAX_STEPS_PLAN=40
# DEEPSEEK_MAX_TASK_TOKENS=3000000     # input-token budget per run (Claude can pass max_tokens per call)
# DEEPSEEK_CACHE_WEIGHT=0.1            # cached input counts this much toward the budget (it costs ~1/10)
# DEEPSEEK_COMPACT_TOKENS=60000        # prompt size at which old tool outputs get shortened
# DEEPSEEK_FANOUT_CONCURRENCY=3        # sub-tasks run at once when a task is split into areas
# DEEPSEEK_MAX_REPLY_CHARS=3200        # size cap of the report Claude sees (~800 tokens)
# DEEPSEEK_MAX_TOOL_STEP_TOKENS=8000   # output tokens per tool-loop step
# DEEPSEEK_MAX_FINAL_TOKENS=16000      # output tokens for the final report
# DEEPSEEK_THINKING=                   # enabled | disabled (all types); default: off for code/tests/docs/question/general
# DEEPSEEK_THINKING_PLAN=enabled       # per type: _CODE _TESTS _DOCS _QUESTION _GENERAL _PLAN _REVIEW _DEBUG _BUGFIX _RESEARCH
# DEEPSEEK_REASONING_EFFORT=low        # only sent when thinking is on
# DEEPSEEK_COMMAND_TIMEOUT_SEC=300
# DEEPSEEK_ALLOW_COMMANDS=make test;cargo fmt --check   # extra auto-allowed command prefixes
# DEEPSEEK_ELICITATION=auto            # auto | off  (ask you directly when the client supports it)
# DEEPSEEK_WORKSPACE=                  # default workspace (default: the folder Claude Code runs in)
